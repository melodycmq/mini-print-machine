# Copy to .env.local for `vercel dev`, and add the same values in Vercel → Project → Settings → Environment Variables.

# Claude picks the six local subjects for each new city.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI draws the prints.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
# low | medium | high (cost goes up with quality)
IMAGE_QUALITY=medium

# Upstash Redis: city lists, image URLs, locks, rate limits.
# (Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob: stores the generated images. Created automatically when you add a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Spending guards.
DAILY_GENERATION_CAP=150
GENERATIONS_PER_IP_PER_HOUR=12
IP_SALT=change-me-to-any-random-string
